<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AtsScanner.Core\AtsScanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ats-scanner</AssemblyName>
    <!-- Date-based (CalVer) version, e.g. 2026.07.30, so releases are self-describing by date.
         Override at build/publish time with -p:VersionPrefix=YYYY.MM.dd to pin an exact release date
         (e.g. in CI, derived from the release tag) instead of the machine's local build date. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd'))</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Authors>ATS Scanner Contributors</Authors>
    <Copyright>Copyright © 2026 ATS Scanner Contributors</Copyright>
    <Description>Local, privacy-first ATS resume scanner for Workday, Greenhouse, Taleo, Lever, SuccessFactors, Haufe-umantis, digitalent.ch, SmartRecruiters, Avature, Personio, and prospective.ch</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/your-username/ASTScannerButWithPrivacy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
