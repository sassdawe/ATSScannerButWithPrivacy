<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AtsScanner.Gui.MainWindow"
        Title="ATS Scanner"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="560">
  <ScrollViewer>
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="16">
      <StackPanel Grid.Row="0" Spacing="2">
        <TextBlock Text="ATS Scanner" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="Privacy-first resume scanning — nothing ever leaves your machine." FontSize="13" Foreground="Gray" />
      </StackPanel>

      <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="16" CornerRadius="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Button Grid.Column="0" Content="Choose Resume…" Click="OnChooseFileClicked" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <ProgressBar Grid.Column="2" Width="90" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="16" CornerRadius="8">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="ATS Platforms" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="All" Command="{Binding SelectAllCommand}" Padding="10,4" FontSize="12" />
            <Button Grid.Column="2" Content="None" Command="{Binding SelectNoneCommand}" Padding="10,4" FontSize="12" Margin="6,0,0,0" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Platforms}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Margin="0,2,16,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Content="Scan Resume" Command="{Binding ScanCommand}" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" />
      </Grid>

      <ScrollViewer Grid.Row="4" Margin="0,4,0,0">
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="LightGray" BorderThickness="1" Padding="14" Margin="0,0,0,10" CornerRadius="8">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PlatformName}" FontWeight="Bold" FontSize="16" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScoreLabel}" Foreground="{Binding RatingBrush}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Rating}" Foreground="{Binding RatingBrush}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding IssuesSummary}" FontSize="13" Foreground="Gray" />
                  </Grid>

                  <Button Content="{Binding ExpanderGlyph}"
                          Click="OnToggleExpandClicked"
                          IsVisible="{Binding HasIssues}"
                          HorizontalAlignment="Left"
                          Padding="10,2"
                          FontSize="10" />

                  <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6">
                    <ItemsControl ItemsSource="{Binding Issues}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,4,0,4" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontWeight="Bold" />
                              <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" FontSize="14" Margin="20,0,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Suggestion}" FontSize="12" Foreground="Gray" Margin="20,0,0,0" IsVisible="{Binding HasSuggestion}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DetectedSections, StringFormat='Detected sections: {0}'}" FontSize="12" Foreground="Green" IsVisible="{Binding HasDetectedSections}" />
                    <TextBlock Text="{Binding MissingSections, StringFormat='Missing sections: {0}'}" FontSize="12" Foreground="Crimson" IsVisible="{Binding HasMissingSections}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,4,0,0">
        <TextBlock Text="Created by David Sass" FontSize="11" Foreground="#FFA09F9F" VerticalAlignment="Center" />
        <TextBlock Text="·" FontSize="11" Foreground="#FFA09F9F" VerticalAlignment="Center" />
        <TextBlock Text="Sponsor on GitHub ❤️" FontSize="11" Foreground="#FFA09F9F" TextDecorations="Underline" VerticalAlignment="Center" PointerPressed="OnSponsorLinkPressed" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
